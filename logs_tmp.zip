2026-09-05T18:08:10.0182477Z   script: const fs = require('fs');
const out = fs.existsSync('output_agri.txt') ? fs.readFileSync('output_agri.txt','utf8').slice(0,4000) : '';
const label = 'agri-daily';
const list = await github.rest.issues.listForRepo({
  owner: context.repo.owner, repo: context.repo.repo,
  state: 'open', labels: label, per_page: 1
});
const body = '## ' + new Date().toISOString().split('T')[0] + '（' + 'yellow'.toUpperCase() + '）\n\n```\n' + out + '\n```\n看板：dashboard_agri.html ｜ 报告：agriculture/REPORT.md';
let issueNumber;
if (list.data.length > 0) {
  issueNumber = list.data[0].number;
  await github.rest.issues.createComment({
    owner: context.repo.owner, repo: context.repo.repo,
    issue_number: issueNumber, body: body
  });
} else {
  const created = await github.rest.issues.create({
    owner: context.repo.owner, repo: context.repo.repo,
    title: '农业板块每日信号（滚动日报，YELLOW/RED 更新）',
    body: body, labels: [label]
  });
  issueNumber = created.data.number;
}
// RED 时再单独开一条警报 issue（保留医药 ARMED 的对称语义）
if ('yellow' === 'red') {
  await github.rest.issues.create({
    owner: context.repo.owner, repo: context.repo.repo,
    title: `农业信号! Score=57 (${new Date().toISOString().split('T')[0]})`,
    body: '```\n' + out + '\n```\n\nV1.2 周期主导：cycle_score 迟滞门 + 恐慌加速',
    labels: ['agri-alert','alert']
  });
}

